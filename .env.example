# ==========================================
# CAREONIX Job Portal - Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# ==========================================

# Database Configuration
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_password

# Gmail SMTP for Notification Service
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=careonixteam@gmail.com
SPRING_MAIL_PASSWORD=your_app_password_here

# JWT Security
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Database Configuration (application-service)
POSTGRES_DB=applicationdb
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_strong_postgres_password

# CORS Settings (comma-separated list of allowed origins, or * for open)
CORS_ALLOWED_ORIGINS=http://localhost:3007,http://localhost:5173

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretHere

