# CAREONIX Frontend - Environment Variables Template
# Copy to .env or .env.production as needed

# In development, leave blank or set to http://localhost:8080 (API Gateway)
# In production, set to your API Gateway domain or leave blank if served behind Nginx reverse proxy
VITE_API_GATEWAY_URL=http://localhost:8080

# Razorpay Test / Live Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyHere

# GitHub OAuth App Client ID
VITE_GITHUB_CLIENT_ID=Ov23li7BdZOdL1WhHgNg
